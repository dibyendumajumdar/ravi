new file mode 100644
--- /dev/null
+++ b/testes/defer.lua
@@ -0,0 +1,162 @@
+-- Defer extension tests; run with the patched Lua 5.5.1 interpreter.
+local log = {}
+local function record(x) log[#log + 1] = x end
+local function expect(s)
+  assert(table.concat(log, ',') == s, table.concat(log, ','))
+  log = {}
+end
+local function resource(name)
+  return setmetatable({}, {__close = function() record(name) end})
+end
+
+-- Shared captures, LIFO order, native <close>, and return values.
+local function f()
+  local n = 1
+  defer record(n) end
+  local r <close> = resource('close')
+  defer record('last') end
+  n = 2
+  return 4, nil, 6
+end
+local a, b, c = f()
+assert(a == 4 and b == nil and c == 6)
+expect('last,close,2')
+
+-- Constants consume no registers; defer still needs its own stack slot.
+do
+  local k <const> = 42
+  defer record(k) end
+  local n = 7
+  defer record(n) end
+end
+expect('7,42')
+
+for i = 1, 3 do
+  defer record(i) end
+  if i == 2 then break end
+end
+expect('1,2')
+do
+  defer record('goto') end
+  goto outside
+end
+::outside::
+expect('goto')
+local i = 0
+repeat
+  i = i + 1
+  defer record(i) end
+until i == 2
+expect('1,2')
+
+local function tail() record('called'); return 1, 2 end
+local function caller()
+  defer record('deferred') end
+  return tail()
+end
+assert(select('#', caller()) == 2)
+expect('called,deferred')
+
+local original, replacement = {}, {}
+local ok, err = pcall(function()
+  defer record('outer') end
+  defer record('error'); error(replacement) end
+  defer record('inner') end
+  error(original)
+end)
+assert(not ok and err == replacement)
+expect('inner,error,outer')
+
+-- Deferred calls cannot yield, but an ordinary <close> method still can.
+local co = coroutine.create(function()
+  defer record('after') end
+  defer coroutine.yield('forbidden') end
+end)
+ok, err = coroutine.resume(co)
+assert(not ok and tostring(err):find('yield'))
+coroutine.close(co)
+expect('after')
+co = coroutine.create(function()
+  local r <close> = setmetatable({}, {__close = function()
+    coroutine.yield('native close')
+  end})
+end)
+ok, a = coroutine.resume(co)
+assert(ok and a == 'native close')
+assert(coroutine.resume(co))
+
+-- Explicit close of a suspended coroutine runs each defer exactly once.
+co = coroutine.create(function()
+  defer record('closed') end
+  coroutine.yield()
+end)
+assert(coroutine.resume(co)); expect('')
+assert(coroutine.close(co)); expect('closed')
+assert(coroutine.close(co)); expect('')
+
+-- Bug-1 scenario: error recovery after yield with stack growth in cleanup.
+co = coroutine.create(function()
+  local ok, err = pcall(function()
+    defer
+      local args = {}
+      for j = 1, 10000 do args[j] = j end
+      local function consume(...) return select('#', ...) end
+      assert(consume(table.unpack(args)) == 10000)
+      record('grown')
+    end
+    coroutine.yield('ready')
+    error(original)
+  end)
+  assert(not ok and err == original)
+  coroutine.yield('recovered')
+end)
+ok, a = coroutine.resume(co); assert(ok and a == 'ready')
+ok, a = coroutine.resume(co); assert(ok and a == 'recovered')
+assert(coroutine.resume(co)); expect('grown')
+
+-- Parsing in 5.5 global declarations and stripped bytecode round trips.
+local source = [[
+  global <const> *
+  local k <const> = 20
+  local n = 0
+  do
+    defer n = n + k end
+    defer n = n + 2 end
+  end
+  return n
+]]
+local chunk = assert(load(source))
+assert(chunk() == 22)
+assert(assert(load(string.dump(chunk, true)))() == 22)
+local dumped = string.dump(chunk, true)
+local stockformat = dumped:sub(1, 5) .. string.char(0) .. dumped:sub(7)
+local loaded, message = load(stockformat)
+assert(not loaded and message:find('format'))
+assert(not load('defer return ... end'))
+assert(not load('goto skip; defer end; ::skip:: return 1'))
+assert(not load('defer'))
+
+-- More than USHRT_MAX stack slots between close-list entries creates dummy nodes.
+do
+  local names = {}
+  for j = 1, 180 do names[j] = 'v' .. j end
+  local deep = assert(load('return function(record) ' ..
+    'local function visit(n) local ' .. table.concat(names, ',') .. '; ' ..
+    'if n > 0 then local r = visit(n-1); return r end; ' ..
+    'defer record("deep") end; return 17 end; ' ..
+    'defer record("root") end; return visit(400) end'))()
+  assert(deep(record) == 17)
+  expect('deep,root')
+end
+
+for _, mode in ipairs({'incremental', 'generational'}) do
+  collectgarbage(mode)
+  for j = 1, 100 do
+    local captured = {j}
+    do
+      defer assert(captured[1] == j) end
+      collectgarbage('collect')
+    end
+  end
+end
+print('defer tests OK')
diff --git a/testes/defer_alloc.c b/testes/defer_alloc.c
new file mode 100644
--- /dev/null
+++ b/testes/defer_alloc.c
@@ -0,0 +1,79 @@
+/* Defer allocation-failure regression. Link against the patched Lua library.
+** Example: cc -I. testes/defer_alloc.c liblua.a -lm -ldl -o defer_alloc
+*/
+#include <stdio.h>
+#include <stdlib.h>
+#include "lua.h"
+#include "lauxlib.h"
+#include "lualib.h"
+
+typedef struct AllocState {
+  int remaining;  /* -1 means no limit */
+  unsigned int seen;
+  int duplicate;
+} AllocState;
+
+static void *limited_alloc (void *ud, void *ptr, size_t old, size_t size) {
+  AllocState *a = (AllocState *)ud;
+  if (size == 0) {
+    free(ptr);
+    return NULL;
+  }
+  if ((ptr == NULL || size > old) && a->remaining >= 0) {
+    if (a->remaining == 0) return NULL;
+    a->remaining--;
+  }
+  return realloc(ptr, size);
+}
+
+static int record (lua_State *L) {
+  void *ud;
+  unsigned int bit = 1u << (unsigned int)luaL_checkinteger(L, 1);
+  AllocState *a;
+  lua_getallocf(L, &ud);
+  a = (AllocState *)ud;
+  if (a->seen & bit) a->duplicate = 1;
+  a->seen |= bit;
+  return 0;
+}
+
+int main (void) {
+  int budget, failures = 0, successes = 0;
+  const char *source =
+    "local x = {} "
+    "defer record(1) end "
+    "local y = {} "
+    "defer record(2); assert(x) end "
+    "local z = {} "
+    "defer record(3); assert(y) end "
+    "for i=1,100 do z[i] = {i} end";
+  for (budget = 0; budget < 300; budget++) {
+    AllocState a = {-1, 0, 0};
+    lua_State *L = lua_newstate(limited_alloc, &a, 0);
+    int status;
+    if (L == NULL) return 1;
+    luaL_openlibs(L);
+    lua_pushcfunction(L, record);
+    lua_setglobal(L, "record");
+    if (luaL_loadstring(L, source) != LUA_OK) return 2;
+    a.remaining = budget;
+    status = lua_pcall(L, 0, 0, 0);
+    a.remaining = -1;
+    if (status == LUA_OK) {
+      successes++;
+      if (a.seen != 14) return 3;
+    }
+    else if (status == LUA_ERRMEM)
+      failures++;
+    else {
+      fprintf(stderr, "unexpected error: %s\n", lua_tostring(L, -1));
+      return 4;
+    }
+    lua_close(L);
+    if (a.duplicate) return 5;
+  }
+  if (failures == 0 || successes == 0) return 6;
+  printf("defer allocation tests OK (%d failures, %d successes)\n",
+         failures, successes);
+  return 0;
+}
